    <!--
        The Liquibase changelogs, and nothing else. Released on its own
        db-schema-X.Y.Z tag stream as address-lookup-db-schema-<version>.zip
        (see `make package-db-schema`) and applied to Aurora by the
        schema-migrator Lambda. The jar exists only so that local runs and
        tests can load the same changelogs from the classpath.
    -->
    <artifactId>address-lookup-db-schema</artifactId>
    <name>address-lookup-db-schema</name>
    <packaging>jar</packaging>
</project>
