databaseChangeLog:
  - changeSet:
      id: 007-seed-isl-builtaddress
      author: address-lookup-api
      changes:
        - loadData:
            file: db/changelog/data/isl_builtaddress.csv
            tableName: add_isl_builtaddress_v3
            schema: os_data
            separator: ","
            quotchar: '"'
            nullPlaceholder: "NULL"
            usePreparedStatements: false
